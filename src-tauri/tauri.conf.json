{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLIP",
  "version": "0.6.1",
  "identifier": "com.thetinyfoundry.flip.mac",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "wheel",
        "title": "FLIP",
        "url": "index.html#wheel",
        "width": 440,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "FLIP Settings",
        "url": "index.html#settings",
        "width": 780,
        "height": 600,
        "minWidth": 680,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "batch",
        "title": "FLIP — Batch Converter",
        "url": "index.html#batch",
        "width": 660,
        "height": 540,
        "minWidth": 560,
        "minHeight": 440,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "onboarding",
        "title": "Welcome to FLIP",
        "url": "index.html#onboarding",
        "width": 620,
        "height": 480,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/flip-tick.wav": "resources/flip-tick.wav",
      "resources/flip-error.wav": "resources/flip-error.wav",
      "resources/flip-success.wav": "resources/flip-success.wav",
      "../native-bridge/bin/flip-macos-bridge": "flip-macos-bridge"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
